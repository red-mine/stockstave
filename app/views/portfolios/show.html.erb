<% money = ->(v) { "¥#{number_with_delimiter(v.round(0).to_i)}" } %>
<% pct = ->(v) { number_to_percentage(v, precision: 1) } %>

<main class="app-shell portfolio-page">
  <header class="guide-header">
    <%= link_to t("portfolio.back"), root_path, class: "back-link" %>
    <p class="eyebrow"><%= t("app.name") %></p>
    <h1><%= t("portfolio.title") %></h1>
    <p class="subtitle"><%= t("portfolio.subtitle") %></p>
    <p class="portfolio-private"><%= t("portfolio.private_note") %></p>
  </header>

  <% if notice %><p class="portfolio-flash is-notice" role="status"><%= notice %></p><% end %>
  <% if alert %><p class="portfolio-flash is-alert" role="alert"><%= alert %></p><% end %>

  <% if @portfolio.empty? %>
    <p class="portfolio-status is-empty"><%= t("portfolio.status.empty") %></p>
  <% elsif @portfolio.needs_rebalance?(@today) %>
    <p class="portfolio-status is-action" id="rebalance-status">
      <strong><%= t("portfolio.status.action") %></strong>
      <% if @portfolio.drifted? %><%= t("portfolio.status.drifted", band: @portfolio.band) %><% end %>
      <% if @portfolio.overdue?(@today) %><%= t("portfolio.status.overdue", date: @portfolio.due_on.iso8601) %><% end %>
    </p>
  <% else %>
    <p class="portfolio-status is-ok" id="rebalance-status">
      <strong><%= t("portfolio.status.ok") %></strong>
      <%= t("portfolio.status.within", band: @portfolio.band) %>
      <% if @portfolio.due_on %><%= t("portfolio.status.next", date: @portfolio.due_on.iso8601) %><% end %>
    </p>
  <% end %>

  <% names = ->(hs) { hs.map(&:name).join(I18n.locale == :zh ? "、" : ", ") } %>
  <% due_soon = @portfolio.due_soon(@today) %>
  <% matured = @portfolio.matured(@today) %>
  <% if matured.any? %>
    <p class="portfolio-status is-action" id="matured-status"><%= t("portfolio.status.matured", names: names.(matured)) %></p>
  <% end %>
  <% if due_soon.any? %>
    <p class="portfolio-status is-action" id="due-status"><%= t("portfolio.status.due_soon", days: Portfolio::DUE_SOON_DAYS, names: names.(due_soon)) %></p>
  <% end %>
  <% @portfolio.over_insured.each do |institution, sum| %>
    <p class="portfolio-status is-action insured-status"><%= t("portfolio.status.over_insured", institution: institution, amount: money.(sum), limit: money.(Portfolio::INSURED_LIMIT)) %></p>
  <% end %>

  <% stale = @portfolio.stale_holdings(@today) %>
  <% if stale.any? %>
    <p class="portfolio-status is-stale"><%= t("portfolio.status.stale", days: Portfolio::STALE_DAYS, names: names.(stale)) %></p>
  <% end %>

  <% if @portfolio.maturities.any? %>
    <section class="panel portfolio-panel" aria-labelledby="maturity-title">
      <div class="panel-heading"><h2 id="maturity-title"><%= t("portfolio.maturity.title") %></h2></div>
      <div class="table-scroll">
        <table class="stock-table portfolio-table" id="maturity-table">
          <thead>
            <tr>
              <th class="text-left"><%= t("portfolio.maturity.date") %></th>
              <th><%= t("portfolio.maturity.days") %></th>
              <th class="text-left"><%= t("portfolio.holdings.name") %></th>
              <th class="text-left"><%= t("portfolio.holdings.institution") %></th>
              <th><%= t("portfolio.holdings.amount") %></th>
              <th><%= t("portfolio.maturity.running") %></th>
            </tr>
          </thead>
          <tbody>
            <% running = 0 %>
            <% @portfolio.maturities.each do |h| %>
              <% running += h.amount %>
              <% left = h.days_left(@today) %>
              <tr class="<%= left <= Portfolio::DUE_SOON_DAYS ? 'is-due' : '' %>">
                <td class="text-left"><strong><%= h.matures_on.iso8601 %></strong></td>
                <td><%= left.negative? ? t("portfolio.maturity.past", days: -left) : t("portfolio.maturity.left", days: left) %></td>
                <td class="text-left"><%= h.name %></td>
                <td class="text-left"><%= h.institution || t("common.dash") %></td>
                <td><%= money.(h.amount) %></td>
                <td><%= money.(running) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="portfolio-hint"><%= t("portfolio.maturity.hint") %></p>
    </section>
  <% end %>

  <section class="panel portfolio-panel" aria-labelledby="mix-title">
    <div class="panel-heading"><h2 id="mix-title"><%= t("portfolio.mix.title") %></h2></div>
    <div class="table-scroll">
      <table class="stock-table portfolio-table" id="mix-table">
        <thead>
          <tr>
            <th class="text-left"><%= t("portfolio.mix.bucket") %></th>
            <th><%= t("portfolio.mix.amount") %></th>
            <th><%= t("portfolio.mix.actual") %></th>
            <th><%= t("portfolio.mix.target") %></th>
            <th><%= t("portfolio.mix.gap") %></th>
            <th><%= t("portfolio.mix.trade") %></th>
          </tr>
        </thead>
        <tbody>
          <% act = @portfolio.needs_rebalance?(@today) %>
          <% @rows.each do |row| %>
            <tr data-bucket="<%= row.bucket %>">
              <td class="text-left"><strong><%= t("portfolio.buckets.#{row.bucket}") %></strong></td>
              <td><%= money.(row.amount) %></td>
              <td><%= pct.(row.actual) %></td>
              <td><%= pct.(row.target) %></td>
              <td class="<%= row.gap.abs > @portfolio.band ? 'is-off' : '' %>"><%= format("%+.1f", row.gap) %></td>
              <td class="trade">
                <% if !act || row.trade.zero? %>
                  <%= t("common.dash") %>
                <% elsif row.trade.positive? %>
                  <span class="buy"><%= t("portfolio.mix.buy", amount: money.(row.trade)) %></span>
                <% else %>
                  <span class="sell"><%= t("portfolio.mix.sell", amount: money.(-row.trade)) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr><td class="text-left"><strong><%= t("portfolio.mix.total") %></strong></td><td><strong><%= money.(@portfolio.total) %></strong></td><td colspan="4"></td></tr>
        </tfoot>
      </table>
    </div>
    <p class="portfolio-hint"><%= t("portfolio.mix.hint") %></p>
  </section>

  <section class="panel portfolio-panel" aria-labelledby="plans-title">
    <div class="panel-heading"><h2 id="plans-title"><%= t("portfolio.plans.title") %></h2></div>
    <% if @tracked.any? %>
      <div class="table-scroll">
        <table class="stock-table portfolio-table" id="plans-table">
          <thead>
            <tr>
              <th class="text-left"><%= t("portfolio.plans.name") %></th>
              <th><%= t("portfolio.plans.progress") %></th>
              <th><%= t("portfolio.plans.invested") %></th>
              <th><%= t("portfolio.plans.value") %></th>
              <th><%= t("portfolio.plans.profit") %></th>
              <th><%= t("portfolio.plans.deposit", rate: @portfolio.compare_rate.to_s("F")) %></th>
              <th><%= t("portfolio.plans.versus") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @tracked.each do |plan, r| %>
              <tr id="plan-<%= plan.id %>">
                <td class="text-left">
                  <strong><%= plan.name %></strong>
                  <small class="portfolio-sub"><%= t("portfolio.plans.schedule", code: plan.fund_code || t("common.dash"), proxy: plan.proxy.upcase, amount: money.(plan.amount), day: plan.day) %></small>
                </td>
                <td><%= "#{r.purchases.size} / #{plan.months}" %></td>
                <td><%= money.(r.invested) %></td>
                <td><%= r.priced ? money.(r.value) : t("common.dash") %></td>
                <td class="<%= r.profit.negative? ? 'is-loss' : 'is-gain' %>"><%= r.priced ? "#{r.profit.negative? ? '−' : '+'}#{money.(r.profit.abs)} (#{format('%+.1f%%', r.return_pct)})" : t("common.dash") %></td>
                <td><%= money.(r.deposit_value) %></td>
                <td class="<%= r.versus_deposit.negative? ? 'is-loss' : 'is-gain' %>"><%= r.priced ? "#{r.versus_deposit.negative? ? '−' : '+'}#{money.(r.versus_deposit.abs)}" : t("common.dash") %></td>
                <td class="portfolio-actions">
                  <%= button_to t("portfolio.holdings.remove"), portfolio_plan_path(plan.id), method: :delete, class: "button button-secondary", form: { data: { turbo_confirm: t("portfolio.holdings.confirm_remove", name: plan.name) } } %>
                </td>
              </tr>
              <tr class="plan-detail">
                <td colspan="8" class="text-left">
                  <% if !r.priced %>
                    <%= t("portfolio.plans.no_prices", proxy: plan.proxy.upcase) %>
                  <% else %>
                    <%= t("portfolio.plans.as_of", date: r.as_of.iso8601) %>
                    <% if r.done %><%= t("portfolio.plans.done") %><% elsif r.next_date %><%= t("portfolio.plans.next", date: r.next_date.iso8601) %><% end %>
                    <% unless r.adjusted %><%= t("portfolio.plans.no_dividends") %><% end %>
                    <% if r.purchases.any? %>
                      <details>
                        <summary><%= t("portfolio.plans.each") %></summary>
                        <table class="stock-table portfolio-table">
                          <thead><tr><th class="text-left"><%= t("portfolio.plans.date") %></th><th><%= t("portfolio.plans.invested") %></th><th><%= t("portfolio.plans.value") %></th><th><%= t("portfolio.plans.profit") %></th></tr></thead>
                          <tbody>
                            <% last = r.purchases.sum(BigDecimal("0"), &:units).zero? ? 0 : r.value / r.purchases.sum(BigDecimal("0"), &:units) %>
                            <% r.purchases.each do |p| %>
                              <% now = (p.units * last).round(2) %>
                              <tr>
                                <td class="text-left"><%= p.date.iso8601 %></td>
                                <td><%= money.(p.amount) %></td>
                                <td><%= money.(now) %></td>
                                <td class="<%= (now - p.amount).negative? ? 'is-loss' : 'is-gain' %>"><%= format("%+.1f%%", ((now - p.amount) / p.amount * 100).to_f) %></td>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      </details>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="portfolio-hint portfolio-hint-top"><%= t("portfolio.plans.empty") %></p>
    <% end %>
    <%= form_with url: portfolio_plans_path, scope: :plan, class: "portfolio-form", local: true, id: "new-plan" do |f| %>
      <label><%= t("portfolio.plans.name") %><%= f.text_field :name, required: true, placeholder: t("portfolio.plans.name_example") %></label>
      <label><%= t("portfolio.plans.fund_code") %><%= f.text_field :fund_code, size: 8, placeholder: "110020" %></label>
      <label><%= t("portfolio.plans.proxy") %><%= f.text_field :proxy, required: true, size: 8, placeholder: "510310" %></label>
      <label><%= t("portfolio.plans.amount") %><%= f.text_field :amount, required: true, inputmode: "decimal", size: 8, placeholder: "2800" %></label>
      <label><%= t("portfolio.plans.day") %><%= f.number_field :day, required: true, min: 1, max: 28, value: 10 %></label>
      <label><%= t("portfolio.plans.start_on") %><%= f.date_field :start_on, required: true, value: @today %></label>
      <label><%= t("portfolio.plans.months") %><%= f.number_field :months, required: true, min: 1, max: 600, value: 12 %></label>
      <%= f.submit t("portfolio.plans.add"), class: "button button-primary" %>
    <% end %>
    <div class="portfolio-form">
      <%= form_with url: portfolio_compare_rate_path, method: :patch, local: true, class: "portfolio-inline" do |f| %>
        <label><%= t("portfolio.plans.compare_rate") %><%= f.text_field :compare_rate, value: @portfolio.compare_rate.to_s("F"), size: 4, inputmode: "decimal" %></label>
        <%= f.submit t("portfolio.settings.save"), class: "button button-secondary", name: nil %>
      <% end %>
      <% if @portfolio.plans.any? %>
        <%= button_to t("portfolio.plans.refresh"), portfolio_fund_events_path, class: "button button-secondary" %>
      <% end %>
    </div>
    <p class="portfolio-hint"><%= t("portfolio.plans.hint") %></p>
  </section>

  <section class="panel portfolio-panel" aria-labelledby="split-title">
    <div class="panel-heading"><h2 id="split-title"><%= t("portfolio.split.title") %></h2></div>
    <%= form_with url: portfolio_path, method: :get, class: "portfolio-form", local: true do |f| %>
      <label><%= t("portfolio.split.label") %>
        <%= f.text_field :new_money, value: @new_money, inputmode: "decimal", placeholder: "1000" %>
      </label>
      <%= f.submit t("portfolio.split.submit"), class: "button button-primary", name: nil %>
    <% end %>
    <% if @split %>
      <ul class="portfolio-split" id="split-result">
        <% Portfolio::BUCKETS.each do |b| %>
          <li><span><%= t("portfolio.buckets.#{b}") %></span><strong><%= money.(@split[b]) %></strong></li>
        <% end %>
      </ul>
      <p class="portfolio-hint"><%= t("portfolio.split.hint") %></p>
    <% end %>
  </section>

  <section class="panel portfolio-panel" aria-labelledby="holdings-title">
    <div class="panel-heading"><h2 id="holdings-title"><%= t("portfolio.holdings.title") %></h2></div>
    <div class="table-scroll">
      <table class="stock-table portfolio-table" id="holdings-table">
        <thead>
          <tr>
            <th class="text-left"><%= t("portfolio.holdings.name") %></th>
            <th class="text-left"><%= t("portfolio.holdings.code") %></th>
            <th class="text-left"><%= t("portfolio.holdings.bucket") %></th>
            <th class="text-left"><%= t("portfolio.holdings.institution") %></th>
            <th><%= t("portfolio.holdings.amount") %></th>
            <th class="text-left"><%= t("portfolio.holdings.matures_on") %></th>
            <th><%= t("portfolio.holdings.updated") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @portfolio.holdings.each do |h| %>
            <tr id="holding-<%= h.id %>">
              <td class="text-left"><%= text_field_tag "holding[name]", h.name, form: "holding-form-#{h.id}", required: true, "aria-label": t("portfolio.holdings.name") %></td>
              <td class="text-left"><%= text_field_tag "holding[code]", h.code, form: "holding-form-#{h.id}", size: 8, "aria-label": t("portfolio.holdings.code") %></td>
              <td class="text-left"><%= select_tag "holding[bucket]", options_for_select(Portfolio::BUCKETS.map { |b| [t("portfolio.buckets.#{b}"), b] }, h.bucket), form: "holding-form-#{h.id}", "aria-label": t("portfolio.holdings.bucket") %></td>
              <td class="text-left"><%= text_field_tag "holding[institution]", h.institution, form: "holding-form-#{h.id}", size: 8, "aria-label": t("portfolio.holdings.institution") %></td>
              <td><%= text_field_tag "holding[amount]", h.amount.to_s("F"), form: "holding-form-#{h.id}", inputmode: "decimal", size: 10, "aria-label": t("portfolio.holdings.amount") %></td>
              <td class="text-left"><%= date_field_tag "holding[matures_on]", h.matures_on, form: "holding-form-#{h.id}", "aria-label": t("portfolio.holdings.matures_on") %></td>
              <td class="<%= stale.include?(h) ? 'is-off' : '' %>"><%= h.updated_on ? h.updated_on.iso8601 : t("common.dash") %></td>
              <td class="portfolio-actions">
                <%= submit_tag t("portfolio.holdings.save"), form: "holding-form-#{h.id}", class: "button button-secondary", name: nil %>
                <%= button_to t("portfolio.holdings.remove"), portfolio_holding_path(h.id), method: :delete, class: "button button-secondary", form: { data: { turbo_confirm: t("portfolio.holdings.confirm_remove", name: h.name) } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%# Row forms live outside the table (a form cannot sit in a <tr>); the
        row's fields join them through their form attribute. %>
    <% @portfolio.holdings.each do |h| %>
      <%= form_with url: portfolio_holding_path(h.id), method: :patch, local: true, id: "holding-form-#{h.id}" do %><% end %>
    <% end %>
    <%= form_with url: portfolio_holdings_path, scope: :holding, class: "portfolio-form", local: true, id: "new-holding" do |f| %>
      <label><%= t("portfolio.holdings.name") %><%= f.text_field :name, required: true, placeholder: t("portfolio.holdings.name_example") %></label>
      <label><%= t("portfolio.holdings.code") %><%= f.text_field :code, size: 8, placeholder: "511360" %></label>
      <label><%= t("portfolio.holdings.bucket") %><%= f.select :bucket, Portfolio::BUCKETS.map { |b| [t("portfolio.buckets.#{b}"), b] } %></label>
      <label><%= t("portfolio.holdings.institution") %><%= f.text_field :institution, size: 8, placeholder: t("portfolio.holdings.institution_example") %></label>
      <label><%= t("portfolio.holdings.amount") %><%= f.text_field :amount, required: true, inputmode: "decimal", placeholder: "10000" %></label>
      <label><%= t("portfolio.holdings.matures_on") %><%= f.date_field :matures_on %></label>
      <%= f.submit t("portfolio.holdings.add"), class: "button button-primary" %>
    <% end %>
    <p class="portfolio-hint"><%= t("portfolio.holdings.hint") %></p>
  </section>

  <section class="panel portfolio-panel" aria-labelledby="settings-title">
    <div class="panel-heading"><h2 id="settings-title"><%= t("portfolio.settings.title") %></h2></div>
    <%= form_with url: portfolio_settings_path, method: :patch, scope: :settings, class: "portfolio-form", local: true, id: "settings-form" do |f| %>
      <% Portfolio::BUCKETS.each do |b| %>
        <label><%= t("portfolio.settings.target", bucket: t("portfolio.buckets.#{b}")) %>
          <%= number_field_tag "settings[targets][#{b}]", @portfolio.targets[b], min: 0, max: 100, step: 1 %>
        </label>
      <% end %>
      <label><%= t("portfolio.settings.band") %><%= f.number_field :band, value: @portfolio.band, min: 1, max: 50, step: 1 %></label>
      <label><%= t("portfolio.settings.interval") %><%= f.number_field :interval, value: @portfolio.interval, min: 1, max: 60, step: 1 %></label>
      <%= f.submit t("portfolio.settings.save"), class: "button button-primary" %>
    <% end %>
    <div class="portfolio-form">
      <p class="portfolio-hint">
        <%= @portfolio.last_rebalanced_on ? t("portfolio.settings.last", date: @portfolio.last_rebalanced_on.iso8601) : t("portfolio.settings.never") %>
      </p>
      <%= button_to t("portfolio.settings.record"), portfolio_rebalanced_path, class: "button button-secondary" %>
    </div>
    <p class="portfolio-hint"><%= t("portfolio.settings.hint") %></p>
  </section>
</main>
