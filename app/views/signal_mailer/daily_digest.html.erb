<h2><%= t("mailer.digest_title", area: @report.area.upcase) %></h2>
<p><%= @report.previous_date %> &rarr; <%= @report.signal_date %></p>

<% @families.each do |family, events| -%>
<% next if events.empty? -%>
<h3><%= family.upcase %> (<%= events.size %>)</h3>
<table>
  <thead>
    <tr><th><%= t("mailer.table.stock") %></th><th><%= t("mailer.table.change") %></th><th><%= t("mailer.table.price") %></th><th><%= t("mailer.table.signals") %></th></tr>
  </thead>
  <tbody>
    <% events.each do |event| -%>
    <tr>
      <td>
        <% if stock_url_for(event.stock) -%>
          <%= link_to event.stock, stock_url_for(event.stock) %>
        <% else -%>
          <%= event.stock %>
        <% end -%>
      </td>
      <td><%= event.previous_family || t("mailer.new") %> &rarr; <%= event.family %></td>
      <td><%= number_with_precision(event.price, precision: 2) %></td>
      <td><%= [event.year_signal, event.lohas_signal].compact.join(" / ") %></td>
    </tr>
    <% end -%>
  </tbody>
</table>
<% end -%>

<% if @base_url -%>
<p><%= link_to t("mailer.open_full_list"), "#{@base_url}/#{@report.area}" %> <%= t("mailer.in_stock_stave") %></p>
<% end -%>
