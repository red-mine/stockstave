<% signals = Stock::SignalCatalog::ENTRIES %>
<% original_examples = [
  { number: 1, code: "SAF1", title: :"guide.examples.items.1.title", text: :"guide.examples.items.1.text" },
  { number: 2, code: "SOX2", title: :"guide.examples.items.2.title", text: :"guide.examples.items.2.text" },
  { number: 3, code: "SEL3", title: :"guide.examples.items.3.title", text: :"guide.examples.items.3.text" },
  { number: 4, code: "BUY4", title: :"guide.examples.items.4.title", text: :"guide.examples.items.4.text" },
  { number: 5, code: "BUY5", title: :"guide.examples.items.5.title", text: :"guide.examples.items.5.text" },
  { number: 6, code: "SEL6", title: :"guide.examples.items.6.title", text: :"guide.examples.items.6.text" },
  { number: 7, code: "SEL7", title: :"guide.examples.items.7.title", text: :"guide.examples.items.7.text" },
  { number: 8, code: "WAT8", title: :"guide.examples.items.8.title", text: :"guide.examples.items.8.text" },
  { number: 9, code: "WAT9", title: :"guide.examples.items.9.title", text: :"guide.examples.items.9.text" },
  { number: 10, code: "CHP0", title: :"guide.examples.items.10.title", text: :"guide.examples.items.10.text" }
] %>

<main class="app-shell guide-page">
  <header class="guide-header">
    <%= link_to t("common.back_to_signals", area: @area.upcase), stocks_by_area_path(@area, signal: @return_signal_filter, anchor: "current-signals"), class: "back-link" %>
    <p class="eyebrow"><%= t("app.name") %></p>
    <h1><%= t("guide.title") %></h1>
    <p class="subtitle"><%= t("guide.subtitle") %></p>
  </header>

  <section class="guide-explainer" aria-label="<%= t("guide.explainer_aria") %>">
    <div><strong><%= t("guide.stave") %></strong><span><%= t("guide.stave_scale") %></span></div>
    <div><strong><%= t("guide.channel") %></strong><span><%= t("guide.channel_scale") %></span></div>
  </section>

  <p class="original-guide-link"><%= link_to t("guide.original_link"), "/stave/stave.png?v=4" %></p>

  <div class="guide-grid">
    <% signals.each do |signal| %>
      <article id="signal-<%= signal[:code].downcase %>" class="guide-card guide-card-<%= signal[:tone] %>">
        <header>
          <%= signal_badge(signal[:code]) %>
          <strong><%= t(signal[:action]) %></strong>
        </header>
        <p><%= t(signal[:summary]) %></p>
        <div class="position-row">
          <span><%= t("guide.stave") %></span>
          <div class="position-track" aria-hidden="true"><i class="position-marker position-<%= signal[:stave_pos] %>"></i></div>
          <small><%= t(signal[:stave]) %></small>
        </div>
        <div class="position-row">
          <span><%= t("guide.channel") %></span>
          <div class="position-track channel-track" aria-hidden="true"><i class="position-marker position-<%= signal[:channel_pos] %>"></i></div>
          <small><%= t(signal[:channel]) %></small>
        </div>
      </article>
    <% end %>
  </div>

  <section class="original-examples" aria-labelledby="original-examples-title">
    <div class="examples-heading">
      <p class="eyebrow"><%= t("guide.examples.eyebrow") %></p>
      <h2 id="original-examples-title"><%= t("guide.examples.title") %></h2>
      <p><%= t("guide.examples.description") %></p>
    </div>
    <ol class="examples-list">
      <% original_examples.each do |example| %>
        <li class="example-item">
          <span class="example-number"><%= example[:number] %></span>
          <div>
            <header>
              <%= signal_badge(example[:code]) %>
              <strong><%= t(example[:title]) %></strong>
            </header>
            <p><%= t(example[:text]) %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <p class="guide-note"><%= t("guide.note") %></p>
</main>
