<main class="app-shell history-page">
  <%= link_to t("common.back_to_signals", area: @area.upcase), stocks_by_area_path(@area), class: "back-link" %>

  <header class="guide-header">
    <p class="eyebrow"><%= t("history.eyebrow") %></p>
    <h1><%= t("history.title") %></h1>
    <p class="subtitle"><%= t("history.subtitle") %></p>
  </header>

  <p class="performance-warning method-note"><%= t("history.method_note_html") %>
    <% if @price_basis == :adjusted %>
      <%= t("history.basis_adjusted") %>
    <% else %>
      <%= t("history.basis_raw", area: @area.upcase) %>
    <% end %>
  </p>

  <section class="history-grid" aria-label="<%= t("history.grid_aria") %>">
    <% @history.each do |area, status| %>
      <article class="history-card">
        <div class="history-card-heading">
          <strong><%= area.upcase %></strong>
          <span class="history-state <%= status[:ready] ? "is-ready" : "is-collecting" %>"><%= status[:ready] ? t("history.ready") : t("history.collecting") %></span>
        </div>
        <dl>
          <div><dt><%= t("history.metrics.trading_dates") %></dt><dd><%= status[:dates] %></dd></div>
          <div><dt><%= t("history.stats.snapshot_rows") %></dt><dd><%= status[:rows] %></dd></div>
          <div><dt><%= t("history.stats.stocks_covered") %></dt><dd><%= status[:stocks] %></dd></div>
          <div><dt><%= t("history.stats.latest_date") %></dt><dd><%= status[:latest_date] || t("history.none_yet") %></dd></div>
        </dl>
        <% if status[:ready] %>
          <p><%= t("history.enough") %></p>
        <% else %>
          <p><%= t("history.more_needed_html", count: @minimum_dates - status[:dates]) %></p>
        <% end %>
      </article>
    <% end %>
  </section>

  <% if @performance.ready && @performance.cohorts.any? %>
    <section class="performance-panel" aria-labelledby="performance-title">
      <div class="performance-heading">
        <div>
          <p class="eyebrow"><%= t("history.performance.eyebrow") %></p>
          <h2 id="performance-title"><%= t("history.performance.title", horizon: @performance.horizon) %></h2>
        </div>
        <span><%= t("history.trading_dates_recorded", dates: @performance.dates) %></span>
      </div>
      <p class="performance-warning"><%= t("history.performance.warning") %></p>
      <div class="performance-grid">
        <% if @performance.baseline.average_return %>
          <article class="performance-card">
            <strong><%= t("history.performance.model_pool") %></strong>
            <dl>
              <div><dt><%= t("history.metrics.average_return") %></dt><dd><%= @performance.baseline.average_return %>%</dd></div>
              <div><dt><%= t("history.metrics.trading_dates") %></dt><dd><%= @performance.baseline.dates %></dd></div>
            </dl>
          </article>
        <% end %>
        <% @performance.cohorts.each do |cohort| %>
          <article class="performance-card">
            <strong><%= cohort.year_signal %> + <%= cohort.lohas_signal %></strong>
            <dl>
              <div><dt><%= t("history.metrics.observations") %></dt><dd><%= cohort.sample_size %></dd></div>
              <div><dt><%= t("history.metrics.win_rate") %></dt><dd><%= cohort.win_rate %>%</dd></div>
              <div><dt><%= t("history.metrics.average_return") %></dt><dd><%= cohort.average_return %>%</dd></div>
              <div><dt><%= t("history.metrics.average_drawdown") %></dt><dd><%= cohort.average_drawdown %>%</dd></div>
              <% if cohort.excess_return %>
                <div><dt><%= t("history.metrics.pool_return") %></dt><dd><%= cohort.baseline_return %>%</dd></div>
                <div><dt><%= t("history.metrics.excess_vs_pool") %></dt><dd><%= cohort.excess_return %>%</dd></div>
              <% end %>
            </dl>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @simulation.ready %>
    <section class="performance-panel" aria-labelledby="simulation-title">
      <div class="performance-heading">
        <div>
          <p class="eyebrow"><%= t("history.simulation.eyebrow") %></p>
          <h2 id="simulation-title"><%= t("history.simulation.title") %></h2>
        </div>
        <span><%= t("history.trading_dates_recorded", dates: @simulation.dates) %></span>
      </div>
      <p class="performance-warning"><%= t("history.simulation.warning_html", positions: Stock::StrategySimulation::MAX_POSITIONS, hold_days: Stock::StrategySimulation::MAX_HOLD_DAYS, buy_cost: number_to_percentage(Stock::StrategySimulation::BUY_COST_RATE * 100, precision: 2), sell_cost: number_to_percentage(Stock::StrategySimulation::SELL_COST_RATE * 100, precision: 2)) %></p>

      <div class="performance-grid">
        <article class="performance-card">
          <strong><%= t("history.simulation.account.title") %></strong>
          <dl>
            <div><dt><%= t("history.simulation.account.starting_cash") %></dt><dd><%= number_with_precision(@simulation.starting_cash, precision: 2) %></dd></div>
            <div><dt><%= t("history.simulation.account.final_equity") %></dt><dd><%= number_with_precision(@simulation.final_equity, precision: 2) %></dd></div>
            <div><dt><%= t("history.simulation.account.total_return") %></dt><dd><%= @simulation.total_return %>%</dd></div>
            <div><dt><%= t("history.simulation.account.max_drawdown") %></dt><dd><%= @simulation.max_drawdown %>%</dd></div>
          </dl>
        </article>
        <article class="performance-card">
          <strong><%= t("history.simulation.trades.title") %></strong>
          <dl>
            <div><dt><%= t("history.simulation.trades.closed") %></dt><dd><%= @simulation.trades.size %></dd></div>
            <div><dt><%= t("history.simulation.trades.win_rate") %></dt><dd><%= @simulation.trades.any? ? "#{(@simulation.trades.count { |trade| trade.return_pct.positive? }.fdiv(@simulation.trades.size) * 100).round(2)}%" : t("common.dash") %></dd></div>
            <% if @simulation.anomalous_trades.positive? %>
              <div><dt><%= t("history.simulation.trades.flagged") %></dt><dd><%= @simulation.anomalous_trades %></dd></div>
            <% end %>
          </dl>
          <% if @simulation.anomalous_trades.positive? %>
            <p><%= t("history.simulation.trades.flagged_explanation", count: @simulation.anomalous_trades) %></p>
          <% end %>
        </article>
        <article class="performance-card">
          <strong><%= t("history.simulation.benchmark.title") %></strong>
          <% if @benchmark.available %>
            <dl>
              <div><dt><%= t("history.simulation.benchmark.index") %></dt><dd><%= @benchmark.index_code %></dd></div>
              <div><dt><%= t("history.simulation.benchmark.buy_and_hold") %></dt><dd><%= @benchmark.total_return %>%</dd></div>
              <div><dt><%= t("history.simulation.benchmark.vs_index") %></dt><dd><%= (@simulation.total_return - @benchmark.total_return).round(2) %>pp</dd></div>
            </dl>
          <% else %>
            <p><%= t("history.simulation.benchmark.unavailable", area: @area.upcase) %></p>
          <% end %>
        </article>
      </div>

      <div class="chart-card">
        <div class="chart-heading">
          <div><p class="eyebrow"><%= t("history.simulation.equity_curve_eyebrow") %></p><h2><%= t("history.simulation.equity_curve_title") %></h2></div>
        </div>
        <%
          chart_series = [{ name: t("history.simulation.series.strategy"), data: @simulation.equity_curve.map { |point| [point.date.to_s, point.equity] } }]
          chart_series << { name: t("history.simulation.series.index"), data: @benchmark_series } if @benchmark.available
        %>
        <%= line_chart chart_series, height: "320px", points: false %>
      </div>

      <div class="table-scroll">
        <table class="stock-table">
          <thead>
            <tr>
              <th><%= t("history.simulation.table.date") %></th>
              <th class="metric-column"><%= t("history.simulation.table.equity") %></th>
              <th class="metric-column"><%= t("history.simulation.table.change") %></th>
              <th class="metric-column"><%= t("history.simulation.table.buys") %></th>
              <th class="metric-column"><%= t("history.simulation.table.sells") %></th>
            </tr>
          </thead>
          <tbody>
            <% @simulation_days.each do |day| %>
              <tr>
                <td><%= day[:date] %></td>
                <td class="metric-column"><%= number_with_precision(day[:equity], precision: 2) %></td>
                <td class="metric-column"><%= day[:change_pct] >= 0 ? "+" : "" %><%= day[:change_pct] %>%</td>
                <td class="metric-column"><%= day[:buys] %></td>
                <td class="metric-column"><%= day[:sells] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="history-note">
    <h2><%= t("history.why_wait.title") %></h2>
    <p><%= t("history.why_wait.body", count: @minimum_dates) %></p>
  </section>
</main>
